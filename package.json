{
  "name": "archiv-des-vergessens-2",
  "private": true,
  "version": "0.3.5-alpha",
  "type": "module",
  "description": "Archiv des Vergessens v2 — greenfield rewrite",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "npm run build -w @adv/client",
    "dev:client": "npm run dev -w @adv/client",
    "dev:server": "npm run dev -w @adv/server",
    "tauri:dev": "npm run dev -w @adv/desktop",
    "launcher:dev": "npm run dev -w @adv/launcher",
    "launcher:build": "npm run build -w @adv/launcher",
    "clippy": "npm run clippy -w @adv/desktop",
    "clippy:launcher": "npm run clippy -w @adv/launcher",
    "e2e": "npm run test -w @adv/e2e",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gate": "node tools/gates/gate.mjs",
    "gate:lite": "node tools/gates/agent-lite.mjs",
    "migrate:v1-saves": "node --experimental-strip-types tools/migrate-v1-saves/migrate-v1-saves.ts",
    "build:site": "wrangler pages functions build --outdir=./dist/site-worker/",
    "dev:site": "npm run build:site && wrangler dev",
    "deploy:site": "npm run build:site && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@11.10.0": true
  }
}
