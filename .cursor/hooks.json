{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.mjs"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/before-shell.mjs",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/post-edit-context.mjs",
        "matcher": "Write|StrReplace|EditNotebook|Delete"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-gate.mjs",
        "loop_limit": 1
      }
    ]
  }
}
