# ==============================================================================
# Caddy Reverse Proxy Configuration für "Archiv des Vergessens"
# ==============================================================================
# Pfad auf dem Server: /etc/caddy/Caddyfile
#
# Caddy kümmert sich automatisch um SSL Zertifikate via Let's Encrypt / ZeroSSL!
#
# Aktivierung:
#   sudo systemctl reload caddy
# ==============================================================================

grimoireinteractive.duckdns.org {
    # Automatisches Reverse Proxying von WebSockets an das Node.js Backend auf Port 8080
    reverse_proxy 127.0.0.1:8080 {
        # Standard Proxy Header
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
