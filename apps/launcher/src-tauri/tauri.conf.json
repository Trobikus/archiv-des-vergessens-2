{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchivDesVergessens-Launcher",
  "version": "0.2.0-alpha",
  "identifier": "com.grimoire.archivdesvergessens.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Archiv des Vergessens — Siegel",
        "label": "main",
        "url": "index.html",
        "width": 1000,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https:"
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "targets": [],
    "icon": [
      "../../desktop/src-tauri/icons/32x32.png",
      "../../desktop/src-tauri/icons/128x128.png",
      "../../desktop/src-tauri/icons/128x128@2x.png",
      "../../desktop/src-tauri/icons/icon.ico"
    ]
  }
}
