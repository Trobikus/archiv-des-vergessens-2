#!/usr/bin/env sh
# Quality gates before push.
# - Release tags (v*.*.*): full `npm run gate` (mandatory, no bypass)
# - Pushing commits to main: agent-lite gate (balancing + i18n + typecheck)

set -e

release_tag_push=0
main_push=0

while read -r local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/tags/v*.*.*)
      release_tag_push=1
      echo "pre-push: release tag $remote_ref → running npm run gate (mandatory)"
      ;;
    refs/heads/main)
      # Empty local sha means delete; skip.
      if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        main_push=1
        echo "pre-push: main → running agent-lite gate"
      fi
      ;;
  esac
done

if [ "$release_tag_push" -eq 1 ]; then
  npm run gate
  exit 0
fi

if [ "$main_push" -eq 1 ]; then
  node tools/gates/agent-lite.mjs
fi

exit 0
