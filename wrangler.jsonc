{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Grimoire Interactive studio site — Workers + static assets
	"name": "grimoire-interactive",
	"compatibility_date": "2026-08-02",
	// Compiled from functions/ via `npm run build:site`
	"main": "./dist/site-worker/index.js",
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		// www → apex middleware must run before static assets
		"run_worker_first": true,
		"not_found_handling": "404-page"
	}
}
